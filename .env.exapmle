DB_NAME=weather_order_assistant_db
DB_PORT=3306
DB_USERNAME=weather_order_assistant_db
DB_PASSWORD=

# 中央氣象署 API
CWA_API_KEY=

# 首次登入使用會套用.env的初始化帳號
# 登入成功後會跳出通知 已建立首個後台管理員帳號；請關閉 APP_ADMIN_BOOTSTRAP 並清除初始化密碼
# 建立完成後將APP_ADMIN_BOOTSTRAP改為true，並且刪除APP_ADMIN_USERNAME、APP_ADMIN_PASSWORD
APP_ADMIN_BOOTSTRAP=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=