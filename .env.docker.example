# 複製成本機專用的 .env.docker；不要將含密碼的檔案提交到 Git。
# 請使用自己的強密碼，不要在正式環境使用這些範例值。
MYSQL_DATABASE=weather_order_assistant_db
MYSQL_USER=weather_app
MYSQL_PASSWORD=change_me_db_password_12345
MYSQL_ROOT_PASSWORD=change_me_root_password_12345
MYSQL_HOST_PORT=3307
APP_HOST_PORT=8081

# 中央氣象署官方 API Key。若留空，與天氣有關的功能可能無法正常呼叫。
CWA_API_KEY=

# 全新 MySQL Volume 第一次建立後台帳號時設定 true。
# 帳號成功建立後改 false，並清空 APP_ADMIN_PASSWORD 後重建 app 容器。
APP_ADMIN_BOOTSTRAP=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_me_admin_password_12345
