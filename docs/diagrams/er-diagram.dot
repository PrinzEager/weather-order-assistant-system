digraph ER {
graph [rankdir=LR, splines=polyline, nodesep=0.35, ranksep=1.00, bgcolor="#fffaf4", pad="0.25", fontname="Noto Sans CJK TC", label="weather_order_assistant_system｜Flyway V001–V011｜9 tables", labelloc=t, fontsize=19, fontcolor="#603f2d"];
node [shape=plain, fontname="Noto Sans CJK TC"];
edge [color="#b77d49", arrowsize=0.6, penwidth=1.3];
product_categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="#fffefc" COLOR="#d7bd9e"><TR><TD BGCOLOR="#ecd6bd" ALIGN="CENTER" CELLPADDING="6"><B><FONT POINT-SIZE="12" COLOR="#5b3923">product_categories</FONT></B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">id (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">name</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">parent_id (FK → self)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">status</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">created_at / updated_at</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">deleted_at</FONT></TD></TR></TABLE>>];
products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="#fffefc" COLOR="#d7bd9e"><TR><TD BGCOLOR="#ecd6bd" ALIGN="CENTER" CELLPADDING="6"><B><FONT POINT-SIZE="12" COLOR="#5b3923">products</FONT></B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">id (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">category_id (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">sku (UNIQUE)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">name / price / unit</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">current_stock / safety_stock</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">status / created_at / updated_at</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">deleted_at</FONT></TD></TR></TABLE>>];
suppliers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="#fffefc" COLOR="#d7bd9e"><TR><TD BGCOLOR="#ecd6bd" ALIGN="CENTER" CELLPADDING="6"><B><FONT POINT-SIZE="12" COLOR="#5b3923">suppliers</FONT></B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">id (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">name / contact_person</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">phone / email (UNIQUE)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">address / status</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">created_at / updated_at</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">deleted_at</FONT></TD></TR></TABLE>>];
supplier_products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="#fffefc" COLOR="#d7bd9e"><TR><TD BGCOLOR="#ecd6bd" ALIGN="CENTER" CELLPADDING="6"><B><FONT POINT-SIZE="12" COLOR="#5b3923">supplier_products</FONT></B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">id (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">supplier_id (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">product_id (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">purchase_price / status</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">created_at / updated_at</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">UNIQUE(supplier_id, product_id)</FONT></TD></TR></TABLE>>];
sales_records [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="#fffefc" COLOR="#d7bd9e"><TR><TD BGCOLOR="#ecd6bd" ALIGN="CENTER" CELLPADDING="6"><B><FONT POINT-SIZE="12" COLOR="#5b3923">sales_records</FONT></B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">id (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">batch_id (UUID text, nullable)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">product_id (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">quantity / returned_quantity</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">unit_price / total_amount</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">date_time / created_at</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">deleted_at</FONT></TD></TR></TABLE>>];
sales_returns [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="#fffefc" COLOR="#d7bd9e"><TR><TD BGCOLOR="#ecd6bd" ALIGN="CENTER" CELLPADDING="6"><B><FONT POINT-SIZE="12" COLOR="#5b3923">sales_returns</FONT></B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">id (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">sales_record_id (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">quantity / return_amount</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">reason / returned_at</FONT></TD></TR></TABLE>>];
purchase_orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="#fffefc" COLOR="#d7bd9e"><TR><TD BGCOLOR="#ecd6bd" ALIGN="CENTER" CELLPADDING="6"><B><FONT POINT-SIZE="12" COLOR="#5b3923">purchase_orders</FONT></B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">id (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">supplier_id (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">order_date / expected_delivery_date</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">order_status / total_amount</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">remark</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">supplier_*_snapshot (5 columns)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">created_at / updated_at</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">deleted_at</FONT></TD></TR></TABLE>>];
purchase_order_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="#fffefc" COLOR="#d7bd9e"><TR><TD BGCOLOR="#ecd6bd" ALIGN="CENTER" CELLPADDING="6"><B><FONT POINT-SIZE="12" COLOR="#5b3923">purchase_order_items</FONT></B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">id (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">purchase_order_id (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">product_id (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">quantity / unit_price / subtotal</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">created_at</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">UNIQUE(order_id, product_id)</FONT></TD></TR></TABLE>>];
app_users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="#fffefc" COLOR="#d7bd9e"><TR><TD BGCOLOR="#ecd6bd" ALIGN="CENTER" CELLPADDING="6"><B><FONT POINT-SIZE="12" COLOR="#5b3923">app_users</FONT></B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">id (PK)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">username (UNIQUE)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">password_hash</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">status</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10" COLOR="#4f4239">created_at / updated_at</FONT></TD></TR></TABLE>>];
product_categories -> product_categories [label="parent_id 0..1", fontsize=9, fontcolor="#69452e",constraint=false];
product_categories -> products [label="1:N", fontsize=9, fontcolor="#69452e"];
products -> sales_records [label="1:N", fontsize=9, fontcolor="#69452e"];
sales_records -> sales_returns [label="1:N", fontsize=9, fontcolor="#69452e"];
suppliers -> supplier_products [label="1:N", fontsize=9, fontcolor="#69452e"];
products -> supplier_products [label="1:N", fontsize=9, fontcolor="#69452e"];
suppliers -> purchase_orders [label="1:N", fontsize=9, fontcolor="#69452e"];
purchase_orders -> purchase_order_items [label="1:N", fontsize=9, fontcolor="#69452e"];
products -> purchase_order_items [label="1:N", fontsize=9, fontcolor="#69452e"];
{rank=source; product_categories; suppliers; app_users;}
}
